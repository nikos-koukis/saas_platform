# Configuration for `docker compose up`. Copy to `.env` before the first run:
#   cp .env.example .env

# Signs session JWTs. The value below is fine for local development only —
# generate a fresh one for anything deployed: openssl rand -base64 48
JWT_SECRET=dev-only-secret-please-replace-in-production-0123456789
JWT_EXPIRES_IN=7d

# Host ports. Change any that are already in use on your machine.
FRONTEND_PORT=3000
BACKEND_PORT=4000
MONGO_PORT=27017

# Credentials created by the seed container.
SEED_USER_EMAIL=demo@saasdash.dev
SEED_USER_PASSWORD=demo12345
