# MongoDB connection string.
# Local Docker Compose uses the service name `mongo`; a host-run backend uses localhost.
MONGODB_URI=mongodb://localhost:27017/saas_platform

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars

# How long an issued session stays valid.
JWT_EXPIRES_IN=7d

# Browser origin allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:3000

# Set to `production` behind HTTPS so the session cookie is marked Secure.
NODE_ENV=development
